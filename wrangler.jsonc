{
  "name": "kh-site",
  "main": "worker/index.js",
  "routes": [
    { "pattern": "kandhdecorators.org.uk", "custom_domain": true },
    { "pattern": "www.kandhdecorators.org.uk", "custom_domain": true }
  ],
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/static/*"],
    "html_handling": "drop-trailing-slash"
  },
  // LIVE: enquiries go to Steve. Needs Steve's own Resend key (onboarding@resend.dev only delivers to that account's owner).
  "vars": {
    "NOTIFY_TO": "steve25hamblin@hotmail.com",
    "RESEND_FROM": "K&H Decorators <onboarding@resend.dev>",
    "DRY_RUN": "0"
  },
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "2501", "simple": { "limit": 30, "period": 60 } },
    { "name": "LEAD_LIMIT", "namespace_id": "2503", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
